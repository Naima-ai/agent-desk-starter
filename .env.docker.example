# Copy to .env (same folder as docker-compose.yml). .env is gitignored.
# Never commit real values.

# REQUIRED. One long random string, shared by both services.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DESK_ACCESS_TOKEN=

# Only when served behind your own domain / reverse proxy:
PUBLIC_ORIGIN=
TS_PUBLIC_ORIGIN=
COOKIE_SECURE=false

# Everything below is optional; leave empty to keep the offline stubs.
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
EMAIL_WEBHOOK_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
FIC_ACCESS_TOKEN=
FIC_COMPANY_ID=
A2A_OPERATOR_TOKEN=
