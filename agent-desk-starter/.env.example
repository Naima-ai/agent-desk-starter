FIC_ACCESS_TOKEN=
FIC_COMPANY_ID=
# Only needed for automatic token refresh on expiry (optional for the demo)
FIC_REFRESH_TOKEN=
FIC_CLIENT_ID=
FIC_CLIENT_SECRET=
WHATSAPP_TOKEN=EAAXLYOx8Dl0BSgpRrVGhj8JWHPZC2JZAfP3w2Niy16XF9lCP0O4ZCSPMf3lRQSqARpbRZBJaotRH38Judp2R4iPbntbYV2yswLCoUX2qg1kvHtJ87mn9R2tOkm6kolbiNLMd5yEQT3drHIHrzhZCD5IGZAqrezZBmBLc8ZCzv0mPhg1Vi0ZAKe2VZCDda9OdTYrEgdHCvZA890A0izxQuOtZCpZC54twGW7PWIxZAlyhwC9FWEEbyVEFsseMYKKmmEmW3hu5L6ZBup0VN5GpnKSvZC6qQRR3
WHATSAPP_PHONE_ID=1382683561587608
WHATSAPP_GRAPH_VERSION=v22.0
# Inbound webhook: any secret string you invent; paste the same value into Meta > WhatsApp > Configuration > Verify token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta > App settings > Basic > App secret. Verifies webhook signatures; required before WhatsApp replies can approve gates.
WHATSAPP_APP_SECRET=
# How long a Validate run waits for the owner's WhatsApp reply before carrying on (ms). Default 5 minutes.
WHATSAPP_REPLY_TIMEOUT_MS=
# Agenzia delle Entrate portal — PREPARE ONLY (never used to auto-transmit)
ADE_ENDPOINT=
ADE_CERT=
# modelGateway.mjs's cloud fallback (used only if the local Ollama/Qwen
# server at LOCAL_SLM_URL isn't reachable). Get a free key at
# https://aistudio.google.com/apikey — put it here, in YOUR OWN .env, never
# directly in modelGateway.mjs or any other file that gets committed.
GEMINI_API_KEY=
# Only needed if Ollama isn't running on its default localhost:11434
LOCAL_SLM_URL=http://host.docker.internal:11434/v1/chat/completions
LOCAL_SLM_MODEL=

# Durable A2A transport. `memory` is for tests/offline demos; production uses
# Redis Streams and requires Redis 7+ for XAUTOCLAIM recovery metadata.
A2A_TRANSPORT=memory
REDIS_URL=redis://127.0.0.1:6379
A2A_MAX_ATTEMPTS=5
A2A_RETENTION=10000
A2A_CLAIM_IDLE_MS=30000
UI_HISTORY_LIMIT=500
# Required as a Bearer token for dead-letter replay operations.
A2A_OPERATOR_TOKEN=

# ---- Security -------------------------------------------------------------
# Set the SAME long random value in teamsystem-firm-mock's environment. When
# set, the UI asks for it at /login and services send it as a Bearer token.
# Leave empty only for local development.
DESK_ACCESS_TOKEN=
# Extra browser origins allowed to call the API (comma-separated), e.g. your
# public URL behind a reverse proxy. Localhost on this port is always allowed.
ALLOWED_ORIGINS=
# 127.0.0.1 = this machine only (default). Use 0.0.0.0 inside Docker.
HOST=127.0.0.1
# true when served over HTTPS (adds the Secure flag to the login cookie)
COOKIE_SECURE=false

# ---- Email channel (studio <-> client) ---------------------------------------
# Leave SMTP_HOST empty to run as an offline stub that only records emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=naima.tasnia@loop.ai
SMTP_PASS=ravm hfvg yrcy nifa
EMAIL_FROM=naima.tasnia@loop.ai
# Receiving by IMAP polling (leave IMAP_HOST empty to disable)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=naima.tasnia@loop.ai
IMAP_PASS=ravm hfvg yrcy nifa
IMAP_POLL_SECONDS=60
# Receiving by provider webhook (POST /api/email/inbound). Disabled when empty.
EMAIL_WEBHOOK_TOKEN=
EMAIL_MAX_ATTACHMENT_BYTES=10485760
