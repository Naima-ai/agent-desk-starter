FIC_ACCESS_TOKEN=
FIC_COMPANY_ID=
# Only needed for automatic token refresh on expiry (optional for the demo)
FIC_REFRESH_TOKEN=
FIC_CLIENT_ID=
FIC_CLIENT_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_VERSION=v22.0
# Agenzia delle Entrate portal — PREPARE ONLY (never used to auto-transmit)
ADE_ENDPOINT=
ADE_CERT=
# modelGateway.mjs's cloud fallback (used only if the local Ollama/Qwen
# server at LOCAL_SLM_URL isn't reachable). Get a free key at
# https://aistudio.google.com/apikey — put it here, in YOUR OWN .env, never
# directly in modelGateway.mjs or any other file that gets committed.
GEMINI_API_KEY=
# Only needed if Ollama isn't running on its default localhost:11434
LOCAL_SLM_URL=
LOCAL_SLM_MODEL=
